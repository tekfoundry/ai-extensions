{
  "name": "@tekfoundry/aix",
  "version": "0.1.2",
  "description": "AI Extensions: a package-manager-style CLI for project-local AI-agent extensions.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekfoundry/ai-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/tekfoundry/ai-extensions/issues"
  },
  "homepage": "https://github.com/tekfoundry/ai-extensions#readme",
  "keywords": [
    "ai",
    "agents",
    "cli",
    "skills",
    "extensions"
  ],
  "bin": {
    "aix": "bin/aix.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "aix",
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "aix": "npm run build && node bin/aix.js",
    "build": "tsc -p tsconfig.json",
    "release:github-artifact": "node scripts/github-release-artifact.mjs",
    "release:local-smoke": "node scripts/local-install-smoke.mjs",
    "release:pack-preview": "node scripts/pack-preview.mjs",
    "release:publish-dry-run": "node scripts/publish-dry-run.mjs",
    "release:verify": "npm run build && npm run typecheck && npm test && npm run release:pack-preview && npm run release:local-smoke",
    "smoke:aix-dev-roles": "npm run build && node scripts/aix-dev-roles-smoke.mjs",
    "smoke:local-assets": "npm run build && node scripts/local-assets-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run build && npm run typecheck && npm test",
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "yoctocolors": "^2.2.0"
  }
}
