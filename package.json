{
  "name": "@tekfoundry/aix",
  "version": "0.0.0",
  "description": "AI Extensions: a package-manager-style CLI for project-local AI-agent extensions.",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekfoundry/ai-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/tekfoundry/ai-extensions/issues"
  },
  "homepage": "https://github.com/tekfoundry/ai-extensions#readme",
  "keywords": [
    "ai",
    "agents",
    "cli",
    "skills",
    "extensions"
  ],
  "bin": {
    "aix": "./bin/aix.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "aix",
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "aix": "npm run build && node bin/aix.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "yoctocolors": "^2.2.0"
  }
}
